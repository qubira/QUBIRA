# ============================================================
# QUBIRA — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Neon PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@tu-host.neon.tech/nombre_db?sslmode=require&channel_binding=require

# JWT — usa una cadena larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria-32chars
JWT_EXPIRES_IN=24h

# Contraseña maestra para ver datos protegidos en el panel de control
MASTER_PASSWORD=cambia-esto-por-una-contraseña-propia

# Puerto del servidor (Render/Railway lo asigna automáticamente con PORT)
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Cloudinary — almacenamiento de videos subidos desde el panel de control
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
